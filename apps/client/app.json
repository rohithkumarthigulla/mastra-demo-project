{
  "expo": {
    "name": "EquipmentExchange",
    "slug": "equipment-exchange",
    "scheme": "equipmentexchange",
    "version": "1.0.0",
    "platforms": ["ios", "android", "web"],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1f4e79"
    },
    "ios": {
      "bundleIdentifier": "com.equipmentexchange.app"
    },
    "android": {
      "package": "com.equipmentexchange.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1f4e79"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow EquipmentExchange to use your photos so you can add them to your equipment listings.",
          "cameraPermission": false,
          "microphonePermission": "Allow EquipmentExchange to use your microphone so you can talk to the assistant. You can always type instead."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow EquipmentExchange to use your microphone so you can talk to the assistant. You can always type instead.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "web": {
      "output": "single",
      "favicon": "./assets/icon.png"
    }
  }
}
