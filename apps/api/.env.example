# Port the API listens on.
PORT=3000
# PostgreSQL connection string (required). Matches the docker-compose database.
DATABASE_URL=postgres://ee:ee@localhost:5432/ee
# Secret used to sign access tokens (required, at least 32 characters).
# Development-only placeholder: generate a real one with `openssl rand -base64 48`.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Comma-separated list of allowed CORS origins. Leave empty to disable CORS.
CORS_ORIGINS=http://localhost:8081
# Directory for uploaded listing photos (optional, relative to apps/api). Gitignored.
# LISTING_MEDIA_DIR=./storage/listing-media
# Largest accepted listing photo in bytes (optional, default 8 MB).
# LISTING_MEDIA_MAX_BYTES=8388608
