{
  "name": "equipment-exchange",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test && pnpm run test:docs",
    "test:docs": "node --test scripts/check-knowledge.test.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "mastra:dev": "mastra dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@mastra/core": "^1.76.0",
    "@mastra/duckdb": "^1.14.0",
    "@mastra/libsql": "^1.26.0",
    "@mastra/loggers": "^1.3.6",
    "@mastra/memory": "^1.37.0",
    "@mastra/observability": "^1.19.0",
    "mastra": "^1.34.0",
    "zod": "^4.6.5"
  }
}
